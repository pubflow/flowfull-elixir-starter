 # Server
PORT=3001
ENVIRONMENT=development

# Database (optional - leave empty to run without DB)
# PostgreSQL/CockroachDB:
# DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
# MySQL:
# DATABASE_URL=mysql://user:pass@localhost:3306/mydb
# SQLite:
# DATABASE_URL=sqlite://./flowfull.db

# Redis (optional - uses LRU cache only if not set)
# REDIS_URL=redis://localhost:6379

# Flowless Integration
# Copy this file to `.env` and update values.
FLOWLESS_API_URL=http://localhost:3000
BRIDGE_VALIDATION_SECRET=your-secret-key-min-32-chars
DEV_ALLOW_BRIDGE_STUB=0

# Session Headers/Cookies
SESSION_HEADER_NAME=x-session-id
SESSION_COOKIE_NAME=session_id

# PASETO
PASETO_PRIVATE_KEY=replace-with-hex-ed25519-private-key
